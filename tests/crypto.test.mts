import { randomBytes } from 'node:crypto';
import { createVaultCrypto, DecryptError } from '../src/lib/crypto/core.ts';
const c = createVaultCrypto((n) => new Uint8Array(randomBytes(n)));
const assert = (ok: unknown, m: string) => { if (!ok) throw new Error('FAIL ' + m); console.log('ok', m); };
const salt = c.createKdfSalt();
let t = Date.now(); const key = await c.deriveKey('rahasia tim 123', salt); console.log('derive ms (node)', Date.now() - t, salt);
const check = c.createKeyCheck(key);
assert(c.verifyKeyCheck(key, check), 'passphrase benar lolos');
const wrong = await c.deriveKey('salah', salt);
assert(!c.verifyKeyCheck(wrong, check), 'passphrase salah ditolak');
const enc = c.encryptText(key, 'Password DB: p@ss 🔑');
assert(c.decryptText(key, enc) === 'Password DB: p@ss 🔑', 'teks round-trip (+emoji)');
assert(c.encryptText(key, 'x') !== c.encryptText(key, 'x'), 'nonce acak tiap enkripsi');
let threw = false; try { c.decryptText(wrong, enc); } catch (e) { threw = e instanceof DecryptError; } assert(threw, 'kunci salah → DecryptError');
const tampered = enc.slice(0, -4) + (enc.endsWith('AAAA') ? 'BBBB' : 'AAAA');
threw = false; try { c.decryptText(key, tampered); } catch (e) { threw = e instanceof DecryptError; } assert(threw, 'data diubah → ditolak');
const file = new Uint8Array(randomBytes(200_000));
const encF = c.encryptBytes(key, file); const dec = c.decryptBytes(key, encF);
assert(dec.length === file.length && dec.every((b, i) => b === file[i]), 'file 200KB round-trip');
