{
  "expo": {
    "name": "Pewe",
    "slug": "pewe",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "pewe",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.refiepratama.pewe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#262626",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.refiepratama.pewe",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#262626",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Pewe memakai Face ID untuk membuka vault."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pewe memakai Face ID untuk membuka vault."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pewe butuh akses foto untuk melampirkan gambar ke entry.",
          "cameraPermission": "Pewe butuh kamera untuk memotret dokumen / layar dan melampirkannya ke entry."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "023549da-11d3-48b1-b1e7-d708722ddc9d"
      }
    },
    "owner": "refie"
  }
}
